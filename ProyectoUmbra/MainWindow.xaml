<Window x:Class="ProyectoUmbra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proyecto Umbra"
        Height="320" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource MainFont}"
        WindowStyle="None">
    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de título personalizada -->
            <Grid Grid.Row="0" Background="{DynamicResource BackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontFamily="{DynamicResource MainFont}"
                       FontSize="18"
                       Foreground="{DynamicResource SubtitleBrush}"/>
                <!-- Botón cerrar -->
                <Button Content="✕"
                    Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{DynamicResource SubtitleBrush}"
                    BorderThickness="0"
                    Click="CloseButton_Click"/>
            </Grid>
            <!-- Contenido principal -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="SubtitleTextBlock"
                               Style="{DynamicResource SubtleHeaderText}"/>
                    <Rectangle Style="{DynamicResource SeparatorLine}"/>
                </Grid>

            </Grid>

            <!-- Botón Start centrado -->
            <Grid Grid.Row="1">
                <Button x:Name="StartButton"
                        Width="160" Height="40" FontSize="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource PrimaryButtonBrush}"
                        Foreground="{DynamicResource PrimaryButtonTextBrush}"/>
            </Grid>
            <Grid Grid.Row="2">
                <!-- Botón historial en la esquina inferior izquierda -->
                <Button x:Name="HistoryButton" Width="40" Height="40"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button.ToolTip>
                        <TextBlock x:Name="HistoryTooltip"/>
                    </Button.ToolTip>
                    <Image Source="/ProyectoUmbra;component/Resources/pergamino.png" Stretch="Uniform"/>
                </Button>
                <!-- Powered by OpenIA en la esquina inferior derecha -->
                <TextBlock Text="Powered by OpenIA"
               FontSize="12" Foreground="#8C7B6B"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </Grid>
        </Grid>
    </Border>
</Window>
