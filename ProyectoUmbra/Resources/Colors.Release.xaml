<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondo principal -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#f4f6f8"/>
    <SolidColorBrush x:Key="SubtitleBrush" Color="#3c4a57"/>

    <!-- Estilo: Subtítulo estilizado -->
    <Style x:Key="SubtleHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{DynamicResource MainFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource SubtitleBrush}"/>
        <Setter Property="Margin" Value="0,30,0,10"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Estilo: Separador visual discreto -->
    <Style x:Key="SeparatorLine" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="#33000000"/>
        <Setter Property="Margin" Value="40,10"/>
    </Style>

    <!-- Botón principal -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#2c3e50"/>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#ecf0f1"/>

    <!-- Botón de historial -->
    <SolidColorBrush x:Key="IconButtonBrush" Color="#95a5a6"/>

    <!-- Tipografía general -->
    <FontFamily x:Key="MainFont">Georgia</FontFamily>
    

</ResourceDictionary>